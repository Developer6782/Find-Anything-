# ── Find Anything — environment ────────────────────────────────────────────────
# This project is BYOK (bring your own key): the user pastes their own Gemini API
# key in the app UI. You normally do NOT need any of these variables.
#
# Optional: a server-side key, used ONLY for demo/QA so a reviewer can click
# "Use server key". It is never sent to the browser and disables nothing else.
# If you leave it unset, the app is 100% BYOK.
#
# GEMINI_API_KEY=

# Server port (the Express server also serves the built SPA in production).
PORT=5180

# Set to "1" to allow the frontend build to call generativelanguage.googleapis.com
# directly instead of through /api (useful for static-only hosting). Default: 0.
# VITE_DIRECT_GEMINI=0
