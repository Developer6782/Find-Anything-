{
  "name": "find-anything",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Find Anything \u2014 AI visual search agent. Upload a reference photo, search your surroundings live with your camera, talk to Gemini, get an accurate bounding box on the target object.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run typecheck && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist-server/server/index.js --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-smoke.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
